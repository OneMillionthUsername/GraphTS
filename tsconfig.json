{
    "compilerOptions": {
        "target": "es6",
        "module": "es2015",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "sourceMap": true,
    }
}